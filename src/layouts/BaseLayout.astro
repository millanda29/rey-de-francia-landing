---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  keywords?: string;
  noindex?: boolean;
  type?: "website" | "article";
}

const {
  title,
  description = "Rey de Francia - Piscina y Hostal en Quito: piscina temperada, sauna, turco, hidromasaje y reservas por WhatsApp.",
  image = "/assets/images/og-image.webp",
  keywords = "hostal en quito, piscina temperada quito, sauna quito, turco quito, hidromasaje quito, manantial rey de francia, hostal chillogallo, piscina chillogallo, piscina y hostal rey de francia",
  noindex = false,
  type = "website",
} = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, "");
const pageUrl = siteUrl ? new URL(Astro.url.pathname, siteUrl).toString() : undefined;
const imageUrl = siteUrl ? new URL(image, siteUrl).toString() : image;
const robotsContent = noindex
  ? "noindex, nofollow"
  : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1";

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Rey de Francia - Piscina y Hostal",
  ...(siteUrl ? { url: siteUrl } : {}),
  inLanguage: "es-EC",
};

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LodgingBusiness",
  name: "Rey de Francia - Piscina y Hostal",
  description,
  ...(siteUrl ? { url: siteUrl } : {}),
  ...(imageUrl ? { image: imageUrl } : {}),
  telephone: ["+593223035551", "+593992577409"],
  priceRange: "$$",
  address: {
    "@type": "PostalAddress",
    streetAddress: "Calle Rafael Garcia S33-239 y Ramon Cabrera, Chillogallo",
    addressLocality: "Quito",
    addressCountry: "EC",
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: "-0.291044",
    longitude: "-78.554826",
  },
  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Thursday", "Friday"],
      opens: "10:00",
      closes: "18:00",
    },
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Saturday", "Sunday"],
      opens: "08:30",
      closes: "18:00",
    },
  ],
  sameAs: [
    "https://www.facebook.com/hostalreydefrancia",
    "https://www.instagram.com/manantialreydefrancia",
    "https://www.tiktok.com/@manantialreydefra",
  ],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="robots" content={robotsContent} />
    <meta name="theme-color" content="#0B1D3A" />
    <meta name="author" content="Rey de Francia - Piscina y Hostal" />

    {pageUrl && <link rel="canonical" href={pageUrl} />}

    <meta property="og:locale" content="es_EC" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Rey de Francia - Piscina y Hostal" />
    {pageUrl && <meta property="og:url" content={pageUrl} />}
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    {imageUrl && <meta property="og:image:type" content="image/webp" />}
    {imageUrl && <meta property="og:image:width" content="1200" />}
    {imageUrl && <meta property="og:image:height" content="630" />}
    <meta property="og:image:alt" content="Instalaciones de Rey de Francia - Piscina y Hostal en Quito" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}
    <meta name="twitter:image:alt" content="Instalaciones de Rey de Francia - Piscina y Hostal en Quito" />

    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
    
    <!-- Preconnect para mejor rendimiento -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600;700&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    
    <!-- Leaflet Map CSS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

    <!-- Icon Font: Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    
    <style is:global>

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        min-width: 0;
      }

      :root {
        /* ── Brand Palette: Rey de Francia ── */
        --color-pool:        #56B1E3;
        --color-deep:        #0B1D3A;
        --color-royal:       #1A3E7A;
        --color-gold:        #CFA94B;
        --color-gold-light:  #D8B859;
        --color-gold-dark:   #A8832E;
        --color-ivory:       #F5F2E8;

        /* Blue scale (derived from brand) */
        --color-primary-50:  #eef6fc;
        --color-primary-100: #d4eaf8;
        --color-primary-200: #a8d4f0;
        --color-primary-300: #56B1E3;
        --color-primary-400: #3a9fd9;
        --color-primary-500: #1A3E7A;
        --color-primary-600: #153266;
        --color-primary-700: #112a55;
        --color-primary-800: #0B1D3A;
        --color-primary-900: #081528;
        --color-primary-950: #040c18;

        /* Neutrals */
        --color-stone-50:  #F5F2E8;
        --color-stone-100: #EDE9DF;
        --color-stone-200: #E5E7EB;
        --color-stone-300: #C8CDD4;
        --color-stone-400: #8B939F;
        --color-stone-500: #5B6472;
        --color-stone-600: #4A5260;
        --color-stone-700: #353C48;
        --color-stone-800: #1A1F2B;
        --color-stone-900: #12161E;

        /* Gold scale */
        --color-amber-50:  #FBF7EC;
        --color-amber-100: #F5EDD4;
        --color-amber-200: #EBD9A8;
        --color-amber-300: #D8B859;
        --color-amber-400: #CFA94B;
        --color-amber-500: #B8943A;
        --color-amber-600: #A8832E;
        --color-amber-700: #8A6B24;
        --color-amber-800: #6D541C;
        --color-amber-900: #503E15;

        /* WhatsApp Brand */
        --color-whatsapp:       #25D366;
        --color-whatsapp-dark:  #128C7E;
        --color-whatsapp-light: #DCF8C6;
        --gradient-whatsapp:    linear-gradient(135deg, #25D366 0%, #128C7E 100%);
        --gradient-blue:        linear-gradient(135deg, #56B1E3 0%, #1A3E7A 100%);
        --gradient-gold:        linear-gradient(135deg, #D8B859 0%, #A8832E 100%);

        /* Semantic tokens */
        --color-primary:        var(--color-deep);
        --color-primary-light:  var(--color-royal);
        --color-accent:         var(--color-pool);
        --color-accent-light:   #7EC5EB;
        --color-accent-dark:    var(--color-royal);
        --color-secondary:      var(--color-gold);
        --color-secondary-light: var(--color-gold-light);
        --color-secondary-dark: var(--color-gold-dark);
        --color-success:        var(--color-whatsapp);
        --color-success-light:  var(--color-whatsapp-light);
        --color-gray-900:       var(--color-stone-900);
        --color-gray-800:       var(--color-stone-800);
        --color-gray-700:       var(--color-stone-700);
        --color-gray-600:       var(--color-stone-600);
        --color-gray-500:       var(--color-stone-500);
        --color-gray-400:       var(--color-stone-400);
        --color-gray-300:       var(--color-stone-300);
        --color-gray-200:       var(--color-stone-200);
        --color-gray-100:       var(--color-stone-100);
        --color-text:           var(--color-stone-800);
        --color-text-light:     var(--color-stone-500);
        --color-text-lighter:   var(--color-stone-400);
        --color-border:         var(--color-stone-200);
        --color-bg:             var(--color-ivory);
        --color-bg-secondary:   #EDE9DF;
        --color-white:          #FFFFFF;

        /* Typography */
        --font-serif: "Cormorant Garamond", serif;
        --font-sans: "Outfit", sans-serif;

        /* Spacing */
        --spacing-xs: 0.5rem;
        --spacing-sm: 1rem;
        --spacing-md: 1.5rem;
        --spacing-lg: 2rem;
        --spacing-xl: 3rem;
        --spacing-2xl: 4rem;

        /* Border Radius */
        --radius-sm: 0.375rem;
        --radius-md: 0.625rem;
        --radius-lg: 1rem;
        --radius-xl: 1.5rem;
        --radius-2xl: 2rem;

        /* Shadows */
        --shadow-soft: 0 4px 24px rgba(11, 29, 58, 0.08);
        --shadow-elevated: 0 12px 40px rgba(11, 29, 58, 0.14);
        --shadow-green: 0 8px 28px rgba(37, 211, 102, 0.38);
        --shadow-gold: 0 8px 24px rgba(207, 169, 75, 0.28);
        --transition-standard: 320ms cubic-bezier(0.22, 1, 0.36, 1);
      }

      html {
        scroll-behavior: smooth;
        width: 100%;
      }

      body {
        font-family: var(--font-sans);
        color: var(--color-text);
        background: var(--color-bg);
        line-height: 1.6;
        text-rendering: optimizeLegibility;
        overflow-x: clip;
        width: 100%;
      }

      img,
      video,
      iframe,
      canvas,
      svg {
        display: block;
        max-width: 100%;
      }

      section,
      header,
      footer,
      main {
        width: 100%;
      }

      h1, h2, h3, h4, h5, h6 {
        font-family: var(--font-serif);
        font-weight: 700;
        line-height: 1.2;
        color: var(--color-primary-900);
      }

      h1 { font-size: clamp(2rem, 5vw, 3.5rem); }
      h2 { font-size: clamp(1.6rem, 4vw, 2.5rem); }
      h3 { font-size: clamp(1.3rem, 3vw, 1.875rem); }

      a {
        color: inherit;
        text-decoration: none;
        transition: color var(--transition-standard), transform var(--transition-standard);
      }

      p, a, li, span, button, input, select, textarea, summary {
        overflow-wrap: anywhere;
      }

      p,
      a,
      li,
      span,
      button,
      input,
      select,
      textarea,
      summary {
        overflow-wrap: anywhere;
      }

      button {
        font-family: var(--font-sans);
        border: none;
        cursor: pointer;
        transition: all var(--transition-standard);
      }

      :focus-visible {
        outline: 3px solid var(--color-primary-400);
        outline-offset: 2px;
        border-radius: 4px;
      }

      ::selection {
        background: rgba(86, 177, 227, 0.25);
        color: var(--color-primary-900);
      }

      /* ── Shared WhatsApp button ── */
      .btn-whatsapp {
        background: var(--gradient-whatsapp);
        color: #fff;
        border: none;
        box-shadow: var(--shadow-green);
      }

      .btn-whatsapp:hover {
        transform: translateY(-3px);
        box-shadow: 0 16px 40px rgba(37, 211, 102, 0.48);
        filter: saturate(1.08);
      }

      .btn-whatsapp:active {
        transform: translateY(0);
      }

      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
          scroll-behavior: auto !important;
        }
      }

      /* Reveal */
      .reveal-item { opacity: 1; transform: none; }
      .reveal-item.is-visible { opacity: 1; transform: none; }

      /* ── Floating WhatsApp Button ── */
      .wa-float {
        position: fixed;
        bottom: 28px;
        right: 28px;
        z-index: 999;
        display: flex;
        align-items: center;
        gap: 0;
      }

      .wa-float-tooltip {
        background: var(--color-deep);
        color: #fff;
        font-size: 0.82rem;
        font-weight: 700;
        padding: 0.55rem 1rem;
        border-radius: 999px 0 0 999px;
        white-space: nowrap;
        box-shadow: 0 4px 20px rgba(11, 29, 58, 0.28);
        transform: translateX(10px);
        opacity: 0;
        pointer-events: none;
        transition: transform 260ms cubic-bezier(0.22, 1, 0.36, 1), opacity 260ms ease;
        letter-spacing: 0.02em;
        border: 1px solid rgba(86, 177, 227, 0.25);
      }

      .wa-float-btn {
        width: 62px;
        height: 62px;
        background: var(--gradient-whatsapp);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        box-shadow: var(--shadow-green);
        cursor: pointer;
        border: 3px solid rgba(255, 255, 255, 0.9);
        position: relative;
        transition: transform 260ms cubic-bezier(0.22, 1, 0.36, 1), box-shadow 260ms ease;
        flex-shrink: 0;
        animation: wa-pulse 2.8s ease-in-out infinite;
      }

      .wa-float-btn::before {
        content: "";
        position: absolute;
        inset: -6px;
        border-radius: 50%;
        border: 2px solid rgba(37, 211, 102, 0.35);
        animation: wa-ring 2.8s ease-out infinite;
      }

      @keyframes wa-pulse {
        0%, 100% { box-shadow: var(--shadow-green); }
        50% { box-shadow: 0 12px 36px rgba(37, 211, 102, 0.55); }
      }

      @keyframes wa-ring {
        0% { transform: scale(1); opacity: 0.6; }
        70%, 100% { transform: scale(1.35); opacity: 0; }
      }

      .wa-float-btn:hover {
        transform: scale(1.08) translateY(-3px);
        box-shadow: 0 16px 42px rgba(37, 211, 102, 0.52);
        animation: none;
      }

      .wa-float-btn:active {
        transform: scale(0.96);
      }

      .wa-float:hover .wa-float-tooltip,
      .wa-float:focus-within .wa-float-tooltip {
        transform: translateX(0);
        opacity: 1;
      }

      @media (max-width: 640px) {
        .wa-float { bottom: 20px; right: 20px; }
        .wa-float-btn { width: 56px; height: 56px; border-width: 2px; }
        .wa-float-tooltip {
          display: block;
          position: absolute;
          bottom: calc(100% + 10px);
          right: 0;
          border-radius: 999px;
          transform: translateY(6px);
          opacity: 1;
          pointer-events: none;
          font-size: 0.76rem;
          padding: 0.4rem 0.75rem;
        }
        .wa-float:hover .wa-float-tooltip { transform: translateY(0); }
      }
    </style>
  </head>
  <body>
    <slot />

    <!-- Floating WhatsApp CTA -->
    <div class="wa-float" aria-label="Reservar por WhatsApp">
      <span class="wa-float-tooltip">Reserva ahora</span>
      <button class="wa-float-btn" id="wa-float-btn" aria-label="Abrir WhatsApp">
        <i class="bi bi-whatsapp" style="font-size:30px; line-height:1;"></i>
      </button>
    </div>

    <script>
      // Floating WhatsApp
      const waFloatBtn = document.getElementById("wa-float-btn");
      if (waFloatBtn) {
        waFloatBtn.addEventListener("click", () => {
          const msg = encodeURIComponent("Hola, me gustaría hacer una reserva en Rey de Francia - Piscina y Hostal. ¿Podrían ayudarme con la disponibilidad y los precios? ¡Gracias!");
          window.open(`https://wa.me/593992577409?text=${msg}`, "_blank");
        });
      }

      // Smooth scroll para links internos
      document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
        anchor.addEventListener("click", (e) => {
          const href = anchor.getAttribute("href");
          if (href && href !== "#") {
            e.preventDefault();
            const target = document.querySelector(href);
            if (target) target.scrollIntoView({ behavior: "smooth" });
          }
        });
      });
    </script>
  </body>
</html>


