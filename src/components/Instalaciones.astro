---
// Componente: Carrusel de instalaciones con fotos actualizadas y encuadre responsive vertical/cuadrado
interface InstalacionSlide {
  image: string;
  alt: string;
  caption: string;
  tag: string;
  width: number;
  height: number;
}

const instalaciones: InstalacionSlide[] = [
  {
    image: "/assets/images/piscina.webp",
    alt: "Piscina temperada techada en Manantial Rey de Francia",
    caption: "Piscina temperada techada para toda la familia",
    tag: "Piscina",
    width: 1200,
    height: 1600,
  },
  {
    image: "/assets/images/piscinaposterior.webp",
    alt: "Piscina temperada con área de descanso y asoleadoras",
    caption: "Piscina amplia con zona de descanso y asoleadoras",
    tag: "Área Recreativa",
    width: 1200,
    height: 1600,
  },
  {
    image: "/assets/images/hidromasaje.webp",
    alt: "Hidromasaje con hidrojets y agua temperada",
    caption: "Hidromasaje con hidrojets para relajación total",
    tag: "Hidromasaje",
    width: 1200,
    height: 1600,
  },
  {
    image: "/assets/images/sauna.webp",
    alt: "Sauna finlandés de calor seco renovado con iluminación cálida",
    caption: "Sauna finlandés renovado con iluminación cálida",
    tag: "Sauna",
    width: 900,
    height: 1600,
  },
  {
    image: "/assets/images/chorrofrio.webp",
    alt: "Chorros de contraste térmico revitalizante",
    caption: "Chorros de contraste térmico para reactivar el cuerpo",
    tag: "Chorros de Contraste",
    width: 1200,
    height: 1600,
  },
  {
    image: "/assets/images/chorrocaliente2.webp",
    alt: "Chorros de agua relajante para alivio muscular",
    caption: "Chorros térmicos para relajación muscular",
    tag: "Chorros Térmicos",
    width: 1200,
    height: 1600,
  },
  {
    image: "/assets/images/turco.webp",
    alt: "Turco de vapor húmedo para bienestar y desintoxicación",
    caption: "Turco de vapor húmedo para renovar energía",
    tag: "Turco",
    width: 900,
    height: 1600,
  },
  {
    image: "/assets/images/bdc.webp",
    alt: "Baños de cajón tradicionales terapéuticos",
    caption: "Baños de cajón y bienestar tradicional",
    tag: "Baños de Cajón",
    width: 1200,
    height: 900,
  },
  {
    image: "/assets/images/habitaciones.webp",
    alt: "Habitaciones cómodas para descanso o estadía",
    caption: "Habitaciones privadas y confortables",
    tag: "Hospedaje",
    width: 900,
    height: 1600,
  },
  {
    image: "/assets/images/habitaciones2.webp",
    alt: "Opciones adicionales de hospedaje para huéspedes",
    caption: "Espacios tranquilos para tu estadía",
    tag: "Habitaciones",
    width: 900,
    height: 1600,
  },
  {
    image: "/assets/images/restaurante.webp",
    alt: "Restaurante de Rey de Francia con menú variado",
    caption: "Restaurante con menú y platos variados",
    tag: "Restaurante",
    width: 1024,
    height: 1536,
  },
  {
    image: "/assets/images/fachada.webp",
    alt: "Fachada principal y acceso en Chillogallo Quito",
    caption: "Fachada principal y fácil acceso",
    tag: "Instalaciones",
    width: 1200,
    height: 1600,
  },
];
---

<section class="carrusel-section" id="instalaciones">
  <div class="container">
    <div class="galley-header">
      <span class="section-kicker">Instalaciones renovadas</span>
      <h2>Conoce nuestros espacios</h2>
      <p class="subtitle">Piscina temperada, nuevo sauna, hidromasaje, chorros térmicos y habitaciones — desliza y descubre todo lo que te espera en tu visita.</p>
    </div>
    
    <div class="carrusel-wrapper" aria-roledescription="carousel" aria-label="Galería de instalaciones de Manantial Rey de Francia">
      <div class="carrusel">
        {
          instalaciones.map((slide, index) => (
            <div
              class:list={["slide", { active: index === 0 }]}
              role="group"
              aria-roledescription="slide"
              aria-label={`Instalación ${index + 1} de ${instalaciones.length}: ${slide.caption}`}
            >
              <img
                src={slide.image}
                alt={slide.alt}
                width={slide.width}
                height={slide.height}
                loading={index === 0 ? "eager" : "lazy"}
                decoding="async"
              />
              <div class="slide-overlay">
                <span class="slide-tag">{slide.tag}</span>
                <p class="slide-caption">{slide.caption}</p>
              </div>
            </div>
          ))
        }
      </div>
      
      <button class="carrusel-btn prev" aria-label="Ver imagen anterior">
        <i class="bi bi-chevron-left" aria-hidden="true"></i>
      </button>
      <button class="carrusel-btn next" aria-label="Ver imagen siguiente">
        <i class="bi bi-chevron-right" aria-hidden="true"></i>
      </button>
      
      <div class="carrusel-dots" role="tablist" aria-label="Controles del carrusel">
        {
          instalaciones.map((slide, index) => (
            <button
              class:list={["dot", { active: index === 0 }]}
              role="tab"
              aria-selected={index === 0 ? "true" : "false"}
              aria-label={`Ir a la foto ${index + 1}: ${slide.tag}`}
              data-index={index}
            ></button>
          ))
        }
      </div>

      <div class="carrusel-counter" aria-live="polite">
        <span class="counter-current">1</span> / <span class="counter-total">{instalaciones.length}</span>
      </div>
    </div>
  </div>
</section>

<style>
  .carrusel-section {
    padding: var(--spacing-2xl) var(--spacing-lg);
    background:
      radial-gradient(700px 360px at 90% 10%, rgba(86, 177, 227, 0.12), transparent),
      radial-gradient(600px 320px at 10% 90%, rgba(207, 169, 75, 0.08), transparent),
      var(--color-white);
  }

  .container {
    max-width: 1280px;
    margin: 0 auto;
  }

  .galley-header {
    text-align: center;
    margin-bottom: var(--spacing-2xl);
  }

  .galley-header .section-kicker {
    margin-bottom: 0.4rem;
  }

  .carrusel-section h2 {
    font-size: clamp(2rem, 3.2vw, 2.75rem);
    color: var(--color-primary);
    margin: var(--spacing-sm) 0 var(--spacing-md);
  }

  .subtitle {
    text-align: center;
    font-size: 1.1rem;
    color: var(--color-text-light);
    max-width: 720px;
    margin: 0 auto;
    line-height: 1.65;
  }

  /* ── Contenedor del Carrusel: Encuadre centrado, vertical y cuadrado responsive ── */
  .carrusel-wrapper {
    position: relative;
    max-width: 860px;
    margin: 0 auto;
    border-radius: var(--radius-2xl);
    overflow: hidden;
    background: #0b1d3a;
    box-shadow:
      0 24px 60px -15px rgba(11, 29, 58, 0.25),
      0 12px 28px -8px rgba(207, 169, 75, 0.18);
    border: 3px solid rgba(255, 255, 255, 0.85);
    isolation: isolate;
  }

  .carrusel {
    display: flex;
    transition: transform 0.65s cubic-bezier(0.22, 1, 0.36, 1);
    scroll-behavior: smooth;
    will-change: transform;
  }

  /* 
    Encuadre responsive de las imágenes:
    - Desktop: cuadrado adaptativo (1:1 con tope de altura a 600px)
    - Tablet: cuadrado perfecto (1:1)
    - Móvil: vertical elegante (4:5)
  */
  .slide {
    min-width: 100%;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    position: relative;
    aspect-ratio: 1 / 1;
    max-height: 620px;
    overflow: hidden;
    background: #0b1d3a;
  }

  .slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transform: scale(1.005);
    transition: transform 900ms cubic-bezier(0.22, 1, 0.36, 1), filter 500ms ease;
  }

  .slide.active img {
    transform: scale(1.04);
  }

  /* Gradiente protector para garantizar legibilidad de la información */
  .slide::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(11, 29, 58, 0.88) 0%,
      rgba(11, 29, 58, 0.42) 32%,
      rgba(11, 29, 58, 0) 65%
    );
    z-index: 1;
    pointer-events: none;
  }

  .slide-overlay {
    position: absolute;
    bottom: 24px;
    left: 24px;
    right: 24px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.4rem;
    z-index: 2;
    pointer-events: none;
  }

  .slide-tag {
    display: inline-flex;
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    background: var(--gradient-gold);
    color: #fff;
    box-shadow: 0 4px 12px rgba(207, 169, 75, 0.35);
  }

  .slide-caption {
    margin: 0;
    color: #ffffff;
    font-size: clamp(1rem, 2vw, 1.25rem);
    font-weight: 600;
    line-height: 1.35;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.6);
  }

  /* ── Botones de navegación (Flechas) ── */
  .carrusel-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 3;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(8px);
    color: var(--color-primary);
    border: none;
    border-radius: 50%;
    width: 48px;
    height: 48px;
    font-size: 1.25rem;
    cursor: pointer;
    transition: transform 0.25s ease, background 0.25s ease, color 0.25s ease, box-shadow 0.25s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8px 24px rgba(11, 29, 58, 0.28);
  }

  .carrusel-btn:hover {
    background: var(--color-gold);
    color: #fff;
    transform: translateY(-50%) scale(1.08);
    box-shadow: 0 12px 30px rgba(207, 169, 75, 0.4);
  }

  .carrusel-btn:active {
    transform: translateY(-50%) scale(0.96);
  }

  .carrusel-btn.prev {
    left: 18px;
  }

  .carrusel-btn.next {
    right: 18px;
  }

  /* ── Puntos indicadores (Dots) ── */
  .carrusel-dots {
    position: absolute;
    bottom: 24px;
    right: 24px;
    display: flex;
    align-items: center;
    gap: 7px;
    z-index: 3;
  }

  .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    border: 2px solid rgba(255, 255, 255, 0.85);
    background: rgba(255, 255, 255, 0.3);
    cursor: pointer;
    padding: 0;
    transition: width 0.3s ease, background 0.3s ease, transform 0.3s ease;
  }

  .dot.active {
    background: var(--color-gold);
    border-color: var(--color-gold);
    width: 22px;
    border-radius: 999px;
    transform: scale(1.05);
  }

  /* ── Contador numérico superior para contexto rápido ── */
  .carrusel-counter {
    position: absolute;
    top: 18px;
    right: 18px;
    background: rgba(11, 29, 58, 0.65);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #fff;
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    font-size: 0.82rem;
    font-weight: 700;
    z-index: 3;
    pointer-events: none;
    letter-spacing: 0.04em;
  }

  /* ── MEDIA QUERIES: Adaptación vertical y cuadrada ── */
  @media (max-width: 900px) {
    .carrusel-wrapper {
      max-width: 100%;
      border-radius: var(--radius-xl);
    }

    .slide {
      aspect-ratio: 1 / 1; /* Cuadrado perfecto en tablets */
      max-height: 540px;
    }

    .carrusel-btn {
      width: 42px;
      height: 42px;
      font-size: 1.1rem;
    }

    .carrusel-btn.prev { left: 12px; }
    .carrusel-btn.next { right: 12px; }
  }

  @media (max-width: 640px) {
    .carrusel-section {
      padding: var(--spacing-xl) 1rem;
    }

    /* En celulares: encuadre vertical (4:5) que maximiza el impacto de fotos en portrait */
    .slide {
      aspect-ratio: 4 / 5;
      max-height: unset;
      min-height: 440px;
    }

    .slide-overlay {
      bottom: 18px;
      left: 16px;
      right: 16px;
    }

    .slide-caption {
      font-size: 1.05rem;
    }

    .carrusel-btn {
      width: 38px;
      height: 38px;
      font-size: 1rem;
      background: rgba(255, 255, 255, 0.82);
    }

    .carrusel-btn.prev { left: 8px; }
    .carrusel-btn.next { right: 8px; }

    .carrusel-dots {
      display: none; /* En pantallas móviles el contador superior y swipe táctil bastan para evitar saturar */
    }

    .carrusel-counter {
      top: 14px;
      right: 14px;
      font-size: 0.78rem;
    }
  }

  @media (max-width: 380px) {
    .slide {
      aspect-ratio: 1 / 1; /* Cuadrado en teléfonos extra pequeños */
      min-height: 320px;
    }

    .slide-caption {
      font-size: 0.95rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .slide img,
    .carrusel,
    .dot,
    .carrusel-btn {
      transition: none !important;
      animation: none !important;
    }
  }
</style>

<script>
  const carrusel = document.querySelector('.carrusel') as HTMLElement | null;
  const wrapper = document.querySelector('.carrusel-wrapper') as HTMLElement | null;
  const slides = document.querySelectorAll('.slide');
  const dots = document.querySelectorAll('.dot');
  const counterCurrent = document.querySelector('.counter-current') as HTMLElement | null;
  const prevBtn = document.querySelector('.carrusel-btn.prev') as HTMLButtonElement | null;
  const nextBtn = document.querySelector('.carrusel-btn.next') as HTMLButtonElement | null;

  let currentIndex = 0;
  let autoPlay: ReturnType<typeof setInterval> | null = null;

  function updateCarrusel() {
    if (!carrusel) return;
    const offset = -currentIndex * 100;
    carrusel.style.transform = `translateX(${offset}%)`;

    slides.forEach((slide, index) => {
      slide.classList.toggle('active', index === currentIndex);
    });

    dots.forEach((dot, index) => {
      const isActive = index === currentIndex;
      dot.classList.toggle('active', isActive);
      dot.setAttribute('aria-selected', isActive ? 'true' : 'false');
    });

    if (counterCurrent) {
      counterCurrent.textContent = String(currentIndex + 1);
    }
  }

  function nextSlide() {
    if (slides.length === 0) return;
    currentIndex = (currentIndex + 1) % slides.length;
    updateCarrusel();
  }

  function prevSlide() {
    if (slides.length === 0) return;
    currentIndex = (currentIndex - 1 + slides.length) % slides.length;
    updateCarrusel();
  }

  function startAutoPlay() {
    stopAutoPlay();
    autoPlay = setInterval(nextSlide, 5500);
  }

  function stopAutoPlay() {
    if (autoPlay) clearInterval(autoPlay);
    autoPlay = null;
  }

  prevBtn?.addEventListener('click', () => { prevSlide(); startAutoPlay(); });
  nextBtn?.addEventListener('click', () => { nextSlide(); startAutoPlay(); });

  // Soporte teclado
  wrapper?.setAttribute('tabindex', '0');
  wrapper?.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight') { nextSlide(); startAutoPlay(); }
    if (e.key === 'ArrowLeft') { prevSlide(); startAutoPlay(); }
  });

  // Pausa en hover / foco para una navegación cómoda
  wrapper?.addEventListener('mouseenter', stopAutoPlay);
  wrapper?.addEventListener('mouseleave', startAutoPlay);
  wrapper?.addEventListener('focusin', stopAutoPlay);
  wrapper?.addEventListener('focusout', startAutoPlay);

  // Swipe táctil en móviles
  let touchStartX = 0;
  wrapper?.addEventListener('touchstart', (e) => {
    touchStartX = e.touches[0].clientX;
    stopAutoPlay();
  }, { passive: true });

  wrapper?.addEventListener('touchend', (e) => {
    const dx = e.changedTouches[0].clientX - touchStartX;
    if (Math.abs(dx) > 40) {
      if (dx < 0) nextSlide();
      else prevSlide();
    }
    startAutoPlay();
  }, { passive: true });

  dots.forEach((dot) => {
    dot.addEventListener('click', (e) => {
      const target = e.currentTarget as HTMLElement;
      const idx = Number(target.dataset.index);
      if (!isNaN(idx)) {
        currentIndex = idx;
        updateCarrusel();
        startAutoPlay();
      }
    });
  });

  updateCarrusel();
  startAutoPlay();
</script>
