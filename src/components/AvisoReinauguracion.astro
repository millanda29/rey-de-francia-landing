        <i class="bi bi-whatsapp"></i>
        <span>WhatsApp</span>
      </a>
    </div>
  </div>
</aside>

<!-- ── Diálogo a ancho completo (Full Width Banner) ── -->
<div class="aviso-overlay" id="aviso-overlay" role="alertdialog" aria-modal="true" aria-labelledby="aviso-titulo">
  <div class="aviso-fullwidth">
    <!-- Hazard decorative stripe top -->
    <div class="festive-stripe" aria-hidden="true"></div>

    <button class="aviso-close" id="aviso-close" aria-label="Cerrar aviso y navegar en el sitio">
      <Icono name="cerrar" size="22" />
    </button>

    <div class="aviso-body">
      <!-- Header de Reinauguración (MÁXIMO PROTAGONISMO) -->
      <div class="header-highlight">
        <div class="status-pill">
          <span class="status-dot" aria-hidden="true">
            <span class="status-ping"></span>
            <span class="status-core"></span>
          </span>
          Manantial Rey de Francia • Piscina &amp; Hostal
        </div>

        <h2 id="aviso-titulo" class="aviso-title">
          🎉 ¡YA TENEMOS FECHA DE <span class="grad-gold">REINAUGURACIÓN</span>! 🎉
        </h2>

        <p class="aviso-date-badge">
          Este <strong>jueves 1 de octubre</strong> volvemos a abrir nuestras puertas. 🥳💦
        </p>
      </div>

      <!-- CONTADOR GIGANTE (PROTAGONISTA) -->
      <div class="big-countdown-container">
        <p class="countdown-eyebrow">Cuenta regresiva para la reapertura oficial</p>
        <div class="countdown-clock" id="countdown-grid">
          <div class="clock-card">
            <span class="clock-val" id="cd-days">00</span>
            <span class="clock-lbl">Días</span>
          </div>
          <span class="clock-divider">:</span>
          <div class="clock-card">
            <span class="clock-val" id="cd-hours">00</span>
            <span class="clock-lbl">Horas</span>
          </div>
          <span class="clock-divider">:</span>
          <div class="clock-card">
            <span class="clock-val" id="cd-minutes">00</span>
            <span class="clock-lbl">Minutos</span>
          </div>
          <span class="clock-divider">:</span>
          <div class="clock-card">
            <span class="clock-val" id="cd-seconds">00</span>
            <span class="clock-lbl">Segundos</span>
          </div>
        </div>
        <p class="clock-live-note" id="cd-status" hidden>
          ✨ ¡Las puertas ya están abiertas! Te esperamos hoy con todas las promociones activas.
        </p>
      </div>

      <!-- SORPRESAS (A TODO LO ANCHO EN 4 COLUMNAS COMPACTAS) -->
      <div class="sorpresas-section">
        <div class="sorpresas-title-wrap">
          <i class="bi bi-gift-fill"></i>
          <span>Y por reinauguración tenemos sorpresas:</span>
        </div>

        <div class="sorpresas-row">
          <div class="sorpresa-item">
            <div class="item-badge gold">Exclusivo</div>
            <div class="item-icon">✨</div>
            <div class="item-info">
              <h4>Primeros 10 clientes</h4>
              <p>Entrada <strong>GRATIS</strong> para piscina, válida el sábado 3 de octubre.</p>
            </div>
          </div>

          <div class="sorpresa-item">
            <div class="item-badge red">Imperdible</div>
            <div class="item-icon">🔥</div>
            <div class="item-info">
              <h4>Jueves y viernes</h4>
              <p>¡<strong>2x1</strong> en entradas de adultos! Piscina, sauna, turco e hidromasaje.</p>
            </div>
          </div>

          <div class="sorpresa-item">
            <div class="item-badge amber">Del 1 al 4 de Octubre</div>
            <div class="item-icon">❤️</div>
            <div class="item-info">
              <h4>Combo con habitación</h4>
              <p>Solo por estos días en <strong>$20.00</strong> <span class="old-price">antes $25.00</span>. ¡Relax total!</p>
            </div>
          </div>

          <div class="sorpresa-item">
            <div class="item-badge teal">Bienestar</div>
            <div class="item-icon">🧖‍♀️</div>
            <div class="item-info">
              <h4>Baños de cajón</h4>
              <p>Disfruta de nuestros tradicionales <strong>baños de cajón</strong> y áreas húmedas.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- BOTÓN WHATSAPP Y ENLACES COMPACTOS -->
      <div class="action-footer">
        <a class="wa-action-btn" href={WA_REINAUGURACION} target="_blank" rel="noopener noreferrer">
          <i class="bi bi-whatsapp"></i>
          <span>📲 Reserva exclusivamente por WhatsApp: 099 257 7409</span>
        </a>
        <p class="action-caption">Cupos y promociones limitadas • Atención inmediata</p>

        <div class="footer-links-row">
          <div class="social-pills">
            {socials.map((s) => (
              <a href={s.href} target="_blank" rel="noopener noreferrer" class="social-pill" aria-label={s.label}>
                <Icono name={s.name} size="16" />
                <span>{s.label}</span>
              </a>
            ))}
          </div>

          <button type="button" class="btn-explore" id="aviso-enter">
            Explorar el sitio web y ver instalaciones
          </button>
        </div>

        <p class="final-tagline">¡Te esperamos en Manantial Rey de Francia! ✨ Chillogallo, Quito - Ecuador</p>
      </div>
    </div>

    <!-- Hazard decorative stripe bottom -->
    <div class="festive-stripe" aria-hidden="true"></div>
  </div>
</div>

<script>
  // ── Fechas y cuenta regresiva ──
  // Reopening: Jueves 1 de Octubre de 2026 a las 10:00 AM (GMT-5 Ecuador)
  const TARGET_TIME = new Date("2026-10-01T10:00:00-05:00").getTime();

  const daysEl = document.getElementById("cd-days");
  const hoursEl = document.getElementById("cd-hours");
  const minutesEl = document.getElementById("cd-minutes");
  const secondsEl = document.getElementById("cd-seconds");
  const statusEl = document.getElementById("cd-status");
  const barTimerEl = document.getElementById("bar-timer");

  const pad = (n: number) => (n < 10 ? `0${n}` : `${n}`);

  const updateCountdown = () => {
    const now = Date.now();
    const diff = TARGET_TIME - now;

    if (diff <= 0) {
      if (daysEl) daysEl.textContent = "00";
      if (hoursEl) hoursEl.textContent = "00";
      if (minutesEl) minutesEl.textContent = "00";
      if (secondsEl) secondsEl.textContent = "00";
      if (statusEl) statusEl.hidden = false;
      if (barTimerEl) barTimerEl.textContent = "¡Puertas Abiertas!";
      return;
    }

    const d = Math.floor(diff / (1000 * 60 * 60 * 24));
    const h = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
    const m = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
    const s = Math.floor((diff % (1000 * 60)) / 1000);

    if (daysEl) daysEl.textContent = pad(d);
    if (hoursEl) hoursEl.textContent = pad(h);
    if (minutesEl) minutesEl.textContent = pad(m);
    if (secondsEl) secondsEl.textContent = pad(s);

    if (barTimerEl) {
      barTimerEl.textContent = `${d}d ${pad(h)}h ${pad(m)}m ${pad(s)}s`;
    }
  };

  updateCountdown();
  setInterval(updateCountdown, 1000);

  // ── Manejo de Apertura y Cierre del Diálogo Modal ──
  const overlay = document.getElementById("aviso-overlay");
  const closeBtn = document.getElementById("aviso-close") as HTMLButtonElement | null;
  const enterBtn = document.getElementById("aviso-enter") as HTMLButtonElement | null;
  const barOpenBtn = document.getElementById("bar-btn-open") as HTMLButtonElement | null;

  const previousFocus = document.activeElement instanceof HTMLElement ? document.activeElement : null;

  const isHidden = overlay?.hasAttribute("hidden");
  if (!isHidden) {
    document.body.style.overflow = "hidden";
    closeBtn?.focus();
  }

  const dismiss = () => {
    overlay?.setAttribute("hidden", "");
    document.body.style.overflow = "";
    previousFocus?.focus?.();
  };

  const showModal = () => {
    overlay?.removeAttribute("hidden");
    document.body.style.overflow = "hidden";
    closeBtn?.focus();
  };

  closeBtn?.addEventListener("click", dismiss);
  enterBtn?.addEventListener("click", dismiss);
  barOpenBtn?.addEventListener("click", showModal);

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && !overlay?.hasAttribute("hidden")) {
      dismiss();
      return;
    }

    if (e.key === "Tab" && overlay && !overlay.hasAttribute("hidden")) {
      const focusables = Array.from(
        overlay.querySelectorAll<HTMLElement>('a[href], button:not([disabled])')
      ).filter((el) => el.offsetParent !== null);

      if (focusables.length === 0) return;
      const first = focusables[0];
      const last = focusables[focusables.length - 1];

      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }
  });
</script>

<style>
  /* ── BARRA SUPERIOR FIJA ── */
  .bar-reinauguracion {
    position: relative;
    z-index: 999;
    background: linear-gradient(90deg, #091730 0%, #153261 50%, #0a1b38 100%);
