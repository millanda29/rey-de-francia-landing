  { name: "facebook", label: "Facebook", href: "https://www.facebook.com/hostalreydefrancia" },
  { name: "instagram", label: "Instagram", href: "https://www.instagram.com/manantialreydefrancia" },
  { name: "tiktok", label: "TikTok", href: "https://www.tiktok.com/@manantialreydefra" },
];

const WA_REINAUGURACION = "https://wa.me/593992577409?text=" + encodeURIComponent("¡Hola! Quisiera reservar con las promociones de reinauguración en Manantial Rey de Francia. ¿Me confirman disponibilidad? ¡Gracias!");
---

<!-- ── Barra fija superior compacta ── -->
<aside class="bar-reinauguracion" id="bar-reinauguracion" aria-label="Aviso de reinauguración">
  <div class="bar-container">
    <div class="bar-text">
      <span class="bar-tag">🎉 ¡REINAUGURACIÓN!</span>
      <span class="bar-copy">
        Abrimos este <strong>jueves 1 de octubre</strong> • 🔥 <strong>2x1</strong> jue-vie • Combo hab. <strong>$20</strong> (1-4 oct)
      </span>
    </div>

    <div class="bar-timer" id="bar-timer-wrap">
      <span class="bar-timer-label">Apertura en:</span>
      <span class="bar-timer-digits" id="bar-timer">00d 00h 00m 00s</span>
    </div>

    <div class="bar-actions">
      <button type="button" class="bar-btn-info" id="bar-btn-open">
        Ver detalles y sorpresas
      </button>
